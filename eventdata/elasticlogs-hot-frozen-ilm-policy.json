{% set p_repo_name =  %es_snapshot_repo_name }
{% set p_rollover_max_age =  rollover_max_age | default("1d") %}
{% set p_rollover_max_shard_size = rollover_max_shard_size | default("30gb") %}
{% set p_frozen_min_age = frozen_min_age | default("5s") %}
{
  "policy": {
    "phases": {
      "hot": {
        "min_age": "0ms",
        "actions": {
          "rollover": {
            "max_primary_shard_size": {{ p_rollover_max_shard_size | tojson }},
            "max_age": {{ p_rollover_max_age | tojson }}
          },
          "set_priority": {
            "priority": 100
          },
          "forcemerge": {
            "max_num_segments": 1
          }
        }
      },
      "frozen": {
        "min_age": {{ p_frozen_min_age | tojson }},
        "actions": {
          "searchable_snapshot": {
            "snapshot_repository": {{ p_repo_name | tojson }},
            "force_merge_index": true
          }
        }
      }
    }
  }
}
